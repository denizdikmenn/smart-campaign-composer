# Optional: docker compose works without a .env file; these are the defaults.
POSTGRES_USER=composer
POSTGRES_PASSWORD=composer
POSTGRES_DB=composer
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
SEED_CUSTOMERS=5000   # synthetic customers loaded on first start; 0 disables

# Claude (audience and content generation). Leave the key empty to use the deterministic mocks.
# Model defaults to claude-haiku-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
